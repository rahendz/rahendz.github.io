---
import Base from '../layouts/Base.astro';

const services = [
  {
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.53 16.122a3 3 0 00-5.78 1.128 2.25 2.25 0 01-2.4 2.245 4.5 4.5 0 008.4-2.245c0-.399-.078-.78-.22-1.128zm0 0a15.998 15.998 0 003.388-1.62m-5.043-.025a15.994 15.994 0 011.622-3.395m3.42 3.42a15.995 15.995 0 004.764-4.648l3.876-5.814a1.151 1.151 0 00-1.597-1.597L14.146 6.32a15.996 15.996 0 00-4.649 4.763m3.42 3.42a6.776 6.776 0 00-3.42-3.42" /></svg>`,
    title: 'UI/UX Design',
    desc: 'From research to high-fidelity prototypes. I design interfaces that are intuitive, accessible, and visually refined.',
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" /></svg>`,
    title: 'Frontend Engineering',
    desc: 'Pixel-perfect implementation with modern frameworks. React, Astro, Next.js, TypeScript. Performance-first.',
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" /></svg>`,
    title: 'Design Systems',
    desc: 'Scalable component libraries with tokens, documentation, and Figma-to-code workflows. Built for teams.',
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" /></svg>`,
    title: 'Motion & Interaction',
    desc: 'Scroll-driven animations, micro-interactions, and page transitions. GSAP, Motion, CSS animations.',
  },
];
---

<Base title="Services — Rahendra Putra" description="Design and frontend engineering services by Rahendra Putra.">

  {/* ── SERVICES HERO ── */}
  <section class="min-h-[50dvh] flex items-end section-gap">
    <div class="container-wide px-6 pt-32 pb-8">
      <p class="text-xs font-mono uppercase tracking-[0.2em] mb-6" style={`color: var(--c-muted);`} data-reveal>Services</p>
      <h1 class="text-5xl md:text-7xl lg:text-8xl font-bold tracking-tighter leading-[0.95]" data-reveal>
        <span style={`color: var(--c-text);`}>What I Do</span>
      </h1>
      <p class="text-lg md:text-xl mt-6 max-w-[55ch] leading-relaxed" style={`color: var(--c-text-secondary);`} data-reveal>
        Design and engineering as one discipline. I handle the full pipeline from concept to production.
      </p>
    </div>
  </section>

  {/* ── SERVICES GRID ── */}
  <section class="section-gap">
    <div class="container-wide px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-0 border-t border-l" style={`border-color: var(--c-border);`}>
        {services.map((service) => (
          <div class="p-8 md:p-12 border-b border-r transition-colors hover:opacity-80" style={`border-color: var(--c-border);`} data-reveal>
            <div class="w-10 h-10 rounded-lg flex items-center justify-center mb-6" style={`background: var(--c-surface); color: var(--c-text);`} set:html={service.icon} />
            <h3 class="text-xl font-bold tracking-tight" style={`color: var(--c-text);`}>{service.title}</h3>
            <p class="text-sm mt-3 leading-relaxed max-w-[48ch]" style={`color: var(--c-text-secondary);`}>{service.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── PROCESS ── */}
  <section class="section-gap" style={`background: var(--c-surface);`}>
    <div class="container-wide px-6">
      <h2 class="text-3xl md:text-5xl font-bold tracking-tighter mb-12" style={`color: var(--c-text);`} data-reveal>How I Work</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div data-reveal>
          <span class="text-6xl font-bold" style={`color: var(--c-border);`}>01</span>
          <h3 class="text-lg font-semibold mt-4" style={`color: var(--c-text);`}>Understand</h3>
          <p class="text-sm mt-2 leading-relaxed" style={`color: var(--c-text-secondary);`}>Deep dive into your goals, users, and constraints. No assumptions. Every project starts with listening.</p>
        </div>
        <div data-reveal>
          <span class="text-6xl font-bold" style={`color: var(--c-border);`}>02</span>
          <h3 class="text-lg font-semibold mt-4" style={`color: var(--c-text);`}>Design</h3>
          <p class="text-sm mt-2 leading-relaxed" style={`color: var(--c-text-secondary);`}>High-fidelity prototypes in Figma. Design systems that scale. Every detail considered before any code is written.</p>
        </div>
        <div data-reveal>
          <span class="text-6xl font-bold" style={`color: var(--c-border);`}>03</span>
          <h3 class="text-lg font-semibold mt-4" style={`color: var(--c-text);`}>Build</h3>
          <p class="text-sm mt-2 leading-relaxed" style={`color: var(--c-text-secondary);`}>Clean, performant frontend code. Component-driven architecture. Motion that serves the experience.</p>
        </div>
      </div>
    </div>
  </section>

  {/* ── CTA ── */}
  <section class="section-gap">
    <div class="container-narrow px-6 text-center" data-reveal>
      <h2 class="text-4xl md:text-6xl font-bold tracking-tighter text-balance" style={`color: var(--c-text);`}>
        Ready to start?
      </h2>
      <p class="text-lg mt-6 max-w-[50ch] mx-auto" style={`color: var(--c-text-secondary);`}>
        Tell me about your project. I'll be honest about whether it's the right fit.
      </p>
      <a href="mailto:hello@rahendra.dev"
         class="inline-flex items-center gap-2 text-sm font-medium px-8 py-4 rounded-full mt-10 transition-all hover:scale-[0.97] active:scale-[0.95]"
         style={`background: var(--c-accent); color: var(--c-bg);`}>
        Let's Talk
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </section>

</Base>
