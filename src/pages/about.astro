---
import Base from '../layouts/Base.astro';

const skills = [
  { category: 'Design', items: ['UI/UX Design', 'Design Systems', 'Figma', 'Prototyping', 'Visual Design'] },
  { category: 'Frontend', items: ['React', 'TypeScript', 'Astro', 'Next.js', 'Tailwind CSS', 'GSAP', 'Motion'] },
  { category: 'Tools', items: ['Git', 'Vercel', 'VS Code', 'Storybook', 'Chromatic'] },
];

const experience = [
  { period: '2024 — Present', role: 'Senior Frontend Engineer', company: 'Studio Digital', desc: 'Leading design system development and frontend architecture for enterprise clients.' },
  { period: '2022 — 2024', role: 'UI/UX Designer & Developer', company: 'Creative Agency', desc: 'Designed and built premium marketing sites and web applications for global brands.' },
  { period: '2020 — 2022', role: 'Frontend Developer', company: 'Tech Startup', desc: 'Built responsive interfaces and implemented design systems from scratch.' },
];
---

<Base title="About — Rahendra Putra" description="Designer and Frontend Engineer crafting premium digital experiences.">

  {/* ── ABOUT HERO ── */}
  <section class="min-h-[60dvh] flex items-end section-gap">
    <div class="container-wide px-6 pt-32 pb-8">
      <p class="text-xs font-mono uppercase tracking-[0.2em] mb-6" style={`color: var(--c-muted);`} data-reveal>About</p>
      <h1 class="text-5xl md:text-7xl lg:text-8xl font-bold tracking-tighter leading-[0.95] text-balance" data-reveal>
        <span style={`color: var(--c-text);`}>Rahendra Putra</span>
      </h1>
      <p class="text-lg md:text-xl mt-6 max-w-[60ch] leading-relaxed" style={`color: var(--c-text-secondary);`} data-reveal>
        Designer who codes. I bridge the gap between design intent and engineering reality, creating interfaces that feel as good as they look.
      </p>
    </div>
  </section>

  {/* ── ABOUT IMAGE + TEXT ── */}
  <section class="section-gap">
    <div class="container-wide px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-5" data-reveal>
          <div class="aspect-[4/5] rounded-2xl overflow-hidden" style={`background: var(--c-surface);`}>
            <img src="https://picsum.photos/seed/rahendra-about/800/1000" alt="Rahendra at work" class="w-full h-full object-cover" loading="lazy" />
          </div>
        </div>
        <div class="lg:col-span-7 lg:pl-8" data-reveal>
          <h2 class="text-3xl md:text-4xl font-bold tracking-tight" style={`color: var(--c-text);`}>The intersection of design and code</h2>
          <div class="mt-8 space-y-5 text-base leading-relaxed" style={`color: var(--c-text-secondary);`}>
            <p>
              I believe the best digital products are built when design and engineering speak the same language. That's why I learned to code — not to become a full-stack developer, but to understand the medium I design for.
            </p>
            <p>
              My work spans design systems, frontend architecture, and motion design. I obsess over the details that make interfaces feel alive: the weight of a transition, the rhythm of a grid, the micro-interactions that guide without shouting.
            </p>
            <p>
              When I'm not pushing pixels or wrestling with CSS, I'm exploring generative art, contributing to open-source projects, or photographing urban architecture.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ── SKILLS ── */}
  <section class="section-gap" style={`background: var(--c-surface);`}>
    <div class="container-wide px-6">
      <h2 class="text-3xl md:text-5xl font-bold tracking-tighter mb-12" style={`color: var(--c-text);`} data-reveal>Capabilities</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {skills.map((group) => (
          <div data-reveal>
            <h3 class="text-sm font-mono uppercase tracking-[0.15em] mb-5" style={`color: var(--c-muted);`}>{group.category}</h3>
            <div class="flex flex-wrap gap-2">
              {group.items.map((skill) => (
                <span class="text-sm px-4 py-2 rounded-full border" style={`border-color: var(--c-border); color: var(--c-text);`}>
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── EXPERIENCE ── */}
  <section class="section-gap">
    <div class="container-wide px-6">
      <h2 class="text-3xl md:text-5xl font-bold tracking-tighter mb-12" style={`color: var(--c-text);`} data-reveal>Experience</h2>
      <div class="space-y-0">
        {experience.map((job, i) => (
          <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-8 py-8 border-t" style={`border-color: var(--c-border);`} data-reveal>
            <div class="md:col-span-3">
              <span class="text-sm font-mono" style={`color: var(--c-muted);`}>{job.period}</span>
            </div>
            <div class="md:col-span-4">
              <h3 class="text-base font-semibold" style={`color: var(--c-text);`}>{job.role}</h3>
              <p class="text-sm mt-1" style={`color: var(--c-text-secondary);`}>{job.company}</p>
            </div>
            <div class="md:col-span-5">
              <p class="text-sm leading-relaxed" style={`color: var(--c-text-secondary);`}>{job.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── SOCIAL PROOF ── */}
  <section class="section-gap" style={`background: var(--c-surface);`}>
    <div class="container-narrow px-6 text-center">
      <div data-reveal>
        <p class="text-xs font-mono uppercase tracking-[0.2em] mb-8" style={`color: var(--c-muted);`}>Trusted by</p>
        <div class="flex items-center justify-center gap-12 opacity-40">
          <span class="text-xl font-bold tracking-tight" style={`color: var(--c-text);`}>Acme Corp</span>
          <span class="text-xl font-bold tracking-tight" style={`color: var(--c-text);`}>Vertex</span>
          <span class="text-xl font-bold tracking-tight" style={`color: var(--c-text);`}>Nozzle</span>
          <span class="text-xl font-bold tracking-tight" style={`color: var(--c-text);`}>Lumina</span>
        </div>
      </div>
    </div>
  </section>

  {/* ── CONTACT CTA ── */}
  <section id="contact" class="section-gap">
    <div class="container-narrow px-6 text-center" data-reveal>
      <h2 class="text-4xl md:text-6xl font-bold tracking-tighter text-balance" style={`color: var(--c-text);`}>
        Let's work together.
      </h2>
      <p class="text-lg mt-6 max-w-[50ch] mx-auto" style={`color: var(--c-text-secondary);`}>
        Have a project in mind? I'm always open to discussing new opportunities and creative collaborations.
      </p>
      <div class="flex items-center justify-center gap-4 mt-10">
        <a href="mailto:hello@rahendra.dev"
           class="inline-flex items-center gap-2 text-sm font-medium px-8 py-4 rounded-full transition-all hover:scale-[0.97] active:scale-[0.95]"
           style={`background: var(--c-accent); color: var(--c-bg);`}>
          Get in Touch
        </a>
        <a href="https://linkedin.com" target="_blank" rel="noopener"
           class="inline-flex items-center gap-2 text-sm font-medium px-8 py-4 rounded-full border transition-all hover:scale-[0.97] active:scale-[0.95]"
           style={`border-color: var(--c-border); color: var(--c-text);`}>
          LinkedIn
        </a>
      </div>
    </div>
  </section>

</Base>
