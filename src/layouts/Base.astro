---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Rahendra Putra — Designer & Frontend Engineer' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <nav class="fixed top-0 inset-x-0 z-50 backdrop-blur-xl border-b" style={`background: color-mix(in srgb, var(--c-bg) 80%, transparent); border-color: var(--c-border);`}>
    <div class="container-wide flex items-center justify-between h-16 px-6">
      <a href="/" class="text-sm font-semibold tracking-tight" style={`color: var(--c-text);`}>RP</a>
      <div class="flex items-center gap-6">
        <a href="/about" class="text-sm font-medium transition-colors hover:opacity-70" style={`color: var(--c-text-secondary);`}>About</a>
        <a href="/portfolio" class="text-sm font-medium transition-colors hover:opacity-70" style={`color: var(--c-text-secondary);`}>Work</a>
        <a href="/services" class="text-sm font-medium transition-colors hover:opacity-70" style={`color: var(--c-text-secondary);`}>Services</a>
        <a href="/about#contact" class="text-sm font-medium px-4 py-2 rounded-full transition-all hover:scale-[0.97]" style={`background: var(--c-accent); color: var(--c-bg);`}>Let's Talk</a>
      </div>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <footer class="section-gap border-t" style={`border-color: var(--c-border);`}>
    <div class="container-wide px-6">
      <div class="flex flex-col md:flex-row items-start justify-between gap-8">
        <div>
          <p class="text-sm font-semibold" style={`color: var(--c-text);`}>Rahendra Putra</p>
          <p class="text-sm mt-1" style={`color: var(--c-text-secondary);`}>Designer & Frontend Engineer</p>
        </div>
        <div class="flex items-center gap-5">
          <a href="https://github.com/rahendz" target="_blank" rel="noopener" class="text-sm transition-colors hover:opacity-70" style={`color: var(--c-text-secondary);`}>GitHub</a>
          <a href="https://linkedin.com" target="_blank" rel="noopener" class="text-sm transition-colors hover:opacity-70" style={`color: var(--c-text-secondary);`}>LinkedIn</a>
          <a href="https://dribbble.com" target="_blank" rel="noopener" class="text-sm transition-colors hover:opacity-70" style={`color: var(--c-text-secondary);`}>Dribbble</a>
          <a href="https://framer.com" target="_blank" rel="noopener" class="text-sm transition-colors hover:opacity-70" style={`color: var(--c-text-secondary);`}>Framer</a>
          <a href="mailto:hello@rahendra.dev" class="text-sm transition-colors hover:opacity-70" style={`color: var(--c-text-secondary);`}>Email</a>
        </div>
      </div>
      <p class="text-xs mt-8" style={`color: var(--c-muted);`}>© 2026 Rahendra Putra. Crafted with intention.</p>
    </div>
  </footer>

  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    document.addEventListener('astro:page-load', () => {
      gsap.registerPlugin(ScrollTrigger);

      const reveals = document.querySelectorAll('[data-reveal]');
      reveals.forEach((el) => {
        gsap.fromTo(el,
          { opacity: 0, y: 30 },
          {
            opacity: 1, y: 0, duration: 0.8,
            ease: 'power3.out',
            scrollTrigger: { trigger: el, start: 'top 85%', once: true }
          }
        );
      });
    });
  </script>
</body>
</html>
